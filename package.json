{
  "name": "mapa-del-mundo-conocido",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:watch": "vitest",
    "cycles": "madge --circular --extensions js src"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
